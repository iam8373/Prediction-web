{
  "name": "predik-consolidated",
  "version": "0.8.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/register-alias.mjs --test --experimental-strip-types tests/payments/*.test.ts tests/config/*.test.ts",
    "test:unit": "node --import ./tests/register-alias.mjs --test --experimental-strip-types tests/payments/*.test.ts tests/config/*.test.ts",
    "test:db": "node --import ./tests/register-alias.mjs --test --experimental-strip-types --test-concurrency=1 tests/db/*.test.ts",
    "test:all": "pnpm test:unit && pnpm test:db",
    "db:bootstrap": "node --import ./tests/register-alias.mjs --experimental-strip-types scripts/db-bootstrap.ts",
    "preflight": "node --import ./tests/register-alias.mjs --experimental-strip-types scripts/preflight.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.16.0",
    "next": "16.3.3",
    "pg": "^8.23.0",
    "react": "^19",
    "react-dom": "^19",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  }
}
