# v0 sandbox internal files
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
.snowflake/
.v0-trash/
.vercel/

# Environment variables — never commit real values.
# `.env.example` documents the required keys with empty values and IS tracked.
.env
.env.*
!.env.example

# Common ignores
node_modules
.next/
.DS_Store
# Generated by Next on every build/dev run; it is not source.
next-env.d.ts
tsconfig.tsbuildinfo

# Delivery archives are hand-off artifacts, not application files: they must not
# be committed, and anything under `public/` is served verbatim by a deploy.
m4-claude.zip
Predik-Phase*-Final.zip
*.zip

# Local working copy used while a phase was in flight. Never part of the app.
isolate/
