# Predik — environment template.
#
# Copy to `.env` (or set these in your host's environment/secrets manager) and
# fill in real values there. NEVER commit real credentials: `.gitignore` ignores
# every `.env*` file, and the application only ever reads these values from the
# server-side process environment.
#
# Anything marked REQUIRED makes the app fail closed (or simply not work) when
# it is missing.

# ---------------------------------------------------------------------------
# Database (REQUIRED)
# ---------------------------------------------------------------------------
# PostgreSQL connection string. Prefer a least-privilege application role: the
# runtime needs SELECT/INSERT/UPDATE on application tables, plus DDL rights only
# if you rely on the automatic schema bootstrap.
#
# Leaving this unset is the most common cause of a "broken" deploy: no page that
# reads PostgreSQL can render. The app says so rather than guessing — the startup
# report in the deploy logs names this variable, and /api/health reports
# database.configured = false.
DATABASE_URL=

# Create missing tables, indexes and triggers on first use: the core catalogue,
# wallet and trading tables as well as the payment and security objects. This is
# the default, and the same idempotent step backs `pnpm db:bootstrap`, so a fresh
# database becomes usable on its first request with no manual step.
# Set to `off` on a deployment whose runtime role has no DDL rights, after
# running `pnpm db:bootstrap` once as the schema owner. With `off` the app never
# issues DDL and reports a missing table instead of creating it.
DATABASE_SCHEMA_BOOTSTRAP=auto

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Admin privilege is granted ONLY to these phone numbers (digits, comma
# separated). In production an unset allowlist means there are no admins — the
# fail-closed direction. Never rely on a phone number hardcoded in source.
ADMIN_PHONES=

# One-time sign-in code.
#   production: set OTP_FIXED_CODE (a deployment secret), otherwise sign-in is
#               refused with 503 instead of using the public demo code
#   development: the built-in demo code is used automatically
OTP_FIXED_CODE=
# Explicit opt-in to the built-in development demo code in production. Only for
# throwaway deployments you do not care about.
ALLOW_DEMO_OTP=false

# Extra origins allowed to make state-changing requests, e.g.
# https://app.example.com. The platform's own preview origins are trusted
# automatically and same-origin requests never need to be listed.
TRUSTED_ORIGINS=

# ---------------------------------------------------------------------------
# Payments — mode and the live-money gate
# ---------------------------------------------------------------------------
# demo (simulated, default) | sandbox (provider test mode) | live (real money)
PAYMENTS_MODE=demo

# Which adapter serves sandbox: "simulated" (default) or "razorpay".
PAYMENTS_SANDBOX_PROVIDER=simulated

# Signing secrets for the simulated adapters (demo / simulator sandbox only).
PAYMENTS_WEBHOOK_SECRET_DEMO=
PAYMENTS_WEBHOOK_SECRET_SANDBOX=

# Razorpay — TEST mode (no real money).
PAYMENTS_RAZORPAY_TEST_KEY_ID=
PAYMENTS_RAZORPAY_TEST_KEY_SECRET=
PAYMENTS_RAZORPAY_TEST_WEBHOOK_SECRET=

# Razorpay — LIVE mode (real money). Configuring these never enables live money;
# the live-activation block below must also be satisfied.
PAYMENTS_RAZORPAY_LIVE_KEY_ID=
PAYMENTS_RAZORPAY_LIVE_KEY_SECRET=
PAYMENTS_RAZORPAY_LIVE_WEBHOOK_SECRET=

# RazorpayX payouts (withdrawals).
PAYMENTS_RAZORPAY_PAYOUT_ACCOUNT_NUMBER=
PAYMENTS_RAZORPAY_PAYOUT_MODE=UPI
PAYMENTS_RAZORPAY_USE_PAYMENT_LINKS=true
# Store-level overrides. Leave empty in production.
PAYMENTS_RAZORPAY_API_BASE=
PAYMENTS_RAZORPAY_ACCOUNT_ID=

# Hosts allowed to serve a hosted checkout page (comma separated, optional —
# razorpay.com / rzp.io / razorpay.me are always allowed).
PAYMENTS_CHECKOUT_HOSTS=

# ---------------------------------------------------------------------------
# Live-money gate (every one of these must be deliberately satisfied)
# ---------------------------------------------------------------------------
# Must be exactly "true" to activate real money. Leave unset to stay off.
PAYMENTS_LIVE_ACTIVATION=
PAYMENTS_LIVE_PROVIDER=razorpay
# Legal classification / compliance acknowledgement recorded by the operator.
PAYMENTS_COMPLIANCE_ACK=
# Accountable owner for live payments.
PAYMENTS_COMPLIANCE_OWNER=
# The jurisdiction this deployment is approved to operate in.
PAYMENTS_LIVE_JURISDICTION=
# Jurisdictions the operator is approved to serve.
PAYMENTS_ALLOWED_LIVE_JURISDICTIONS=

# ---------------------------------------------------------------------------
# Production payment posture
# ---------------------------------------------------------------------------
# In production a requested payment mode is never silently downgraded: if
# PAYMENTS_MODE asks for live (or sandbox) and a prerequisite is missing, the
# deployment REFUSES to move balances (503 PAYMENTS_CONFIG_DEGRADED) instead of
# quietly crediting simulated money.
#
# The only way a production runtime may move balances through the SIMULATED
# provider is this explicit acknowledgement, for a deliberately non-money
# deployment such as a public demo. Never set it on a deployment that takes real
# money. `/api/health` reports this as payments.mutationBlocked.
PAYMENTS_ALLOW_SIMULATED_IN_PRODUCTION=

# ---------------------------------------------------------------------------
# Abuse protection (optional overrides; sane defaults are built in)
# ---------------------------------------------------------------------------
# RATE_LIMIT_<BUCKET>_LIMIT / RATE_LIMIT_<BUCKET>_WINDOW_MS, where <bucket> is an
# upper-snake-cased bucket name, e.g.
#   RATE_LIMIT_WITHDRAWAL_LIMIT=10
#   RATE_LIMIT_OTP_REQUEST_PHONE_LIMIT=5
# Buckets: OTP_REQUEST_PHONE, OTP_REQUEST_IP, OTP_VERIFY_PHONE, OTP_VERIFY_IP,
# DEPOSIT, WITHDRAWAL, TRADE, REFERRAL_CLAIM, ADMIN_ACTION, ADMIN_MARKET,
# WEBHOOK, ACCOUNT_READ.
